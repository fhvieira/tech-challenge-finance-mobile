# Configuracao publica do Firebase Web SDK (Firebase Console > configuracao Web).
# EXPO_PUBLIC_* fica visivel no bundle. Nunca use para senhas ou chaves privadas.
# Copie para .env e preencha os seis campos com a configuracao do mesmo projeto.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Somente para scripts/seedTransactions.mjs; NAO adicionar prefixo EXPO_PUBLIC_.
# Opcionais para o aplicativo; obrigatorias somente ao executar o seed.
# SEED_USER_EMAIL=
# SEED_USER_PASSWORD=
